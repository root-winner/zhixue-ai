# ============================================
# 智学AI 环境变量配置模板
# 使用方法: 复制本文件为 .env, 填入你的配置
#   cp .env.example .env
# ============================================

# --- LLM 大模型配置 ---
# 默认使用 OpenAI 兼容接口, 可无缝切换通义千问/智谱/DeepSeek等
# 通义千问: https://dashscope.aliyun.com/compatible-mode/v1
# 智谱AI:   https://open.bigmodel.cn/api/paas/v4
# DeepSeek: https://api.deepseek.com/v1

LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# --- Embedding 向量模型配置 ---
# 方式一: 使用 OpenAI 兼容 Embedding 接口(需联网)
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small

# 方式二: 使用本地 Embedding 模型(离线可用, 首次启动自动下载)
# 设为 local 时忽略上面的 API 配置
USE_LOCAL_EMBEDDING=false
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- 向量数据库 ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# --- RAG 参数 ---
CHUNK_SIZE=500                    # 文档切分块大小(字符)
CHUNK_OVERLAP=50                  # 切分重叠区(字符)
RETRIEVAL_TOP_K=4                 # 检索返回数量
RERANK_TOP_K=2                    # 重排序后保留数量

# 检索策略: vector(纯向量) / bm25(纯关键词) / hybrid(混合检索, 默认)
RETRIEVAL_STRATEGY=hybrid
# 混合检索: 各路召回数量
HYBRID_VECTOR_TOP_K=5
HYBRID_BM25_TOP_K=5
# RRF(Reciprocal Rank Fusion) 融合常数
RRF_K=60

# Cross-Encoder 重排序(可选, 需安装 FlagEmbedding: pip install FlagEmbedding)
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- 对话记忆 ---
MAX_HISTORY_TOKENS=2000           # 历史对话最大 token 数
SESSION_TIMEOUT=3600              # 会话超时(秒)
# 记忆后端: memory(内存, 重启丢失) / sqlite(持久化, 默认)
MEMORY_BACKEND=sqlite
SQLITE_PATH=./data/chat_memory.db

# --- 服务配置 ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# --- 天气工具(可选) ---
# 免费接口: https://wttr.in (无需 key)
# 或使用和风天气: https://dev.qweather.com
WEATHER_API_KEY=
